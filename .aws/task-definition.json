{
  "family": "etido-tdd-task-def",
  "executionRoleArn": "arn:aws:iam::261219435789:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "my-container",
      "image": "261219435789.dkr.ecr.eu-west-2.amazonaws.com/etido-tdd-recap:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512"
}